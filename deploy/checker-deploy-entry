#!/usr/bin/env bash
# ForceCommand of the `deploy-checker` SSH user (sshd_config.d/61-deploy-checker.conf).
# The only thing that key can ask for: "deploy <sha>" or "check <sha>".
# Everything else is refused before sudo is even reached.
set -euo pipefail
cmd="${SSH_ORIGINAL_COMMAND:-}"
if [[ "$cmd" =~ ^(deploy|check)\ ([0-9a-f]{40})$ ]]; then
  exec /usr/bin/sudo -n /usr/local/sbin/checker-deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
fi
echo "refused. allowed: deploy <40-hex commit> | check <40-hex commit>" >&2
exit 2
